{
  "name": "caldav-calendar-generator",
  "version": "1.0.0",
  "description": "AI-powered calendar event generator that extracts event information from email content and creates ICS files or Google Calendar events",
  "main": "dist/server/server.js",
  "type": "module",
  "scripts": {
    "start": "npm run build && node dist/server/server.js",
    "dev": "tsx watch server/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "calendar",
    "ics",
    "caldav",
    "google-calendar",
    "openai",
    "gpt",
    "event-parser",
    "email-parser"
  ],
  "author": "Toru Ishii",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "google-auth-library": "^9.15.1",
    "googleapis": "^144.0.0",
    "openai": "^4.80.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.1.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.1.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
